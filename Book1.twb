      <column caption='Hero Win' datatype='integer' name='[Calculation_1702631506370562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF STARTSWITH([Pivot Field Names], &quot;Radiant&quot;) AND [radiant_win_True] = 1 THEN 1&#13;&#10;&#13;&#10;ELSEIF STARTSWITH([Pivot Field Names], &quot;Dire&quot;) AND [radiant_win_True] = 0 THEN 1&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
