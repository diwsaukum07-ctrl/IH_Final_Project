      <column caption='Winner' datatype='string' name='[Calculation_1702631499513856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [radiant_win_True] = 1 THEN &quot;Radiant&quot;&#13;&#10;ELSE &quot;Dire&quot;&#13;&#10;END' />
